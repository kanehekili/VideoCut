#!/usr/bin/make -f

%:
	dh $@

# The desktop file references the icon by theme name, so install it under
# hicolor as well - the copy below /usr/lib/videocut stays for the app itself.
override_dh_install:
	dh_install
	install -Dm644 src/icons/movie-icon.png \
	  debian/videocut/usr/share/icons/hicolor/128x128/apps/videocut.png
