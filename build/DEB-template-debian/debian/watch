# Upstream "releases" are git tags without a "v" prefix (e.g. "3.2.2"), so
# uscan follows the tag archives rather than the hand-built release assets:
# videocutX.Y.Z.tar is a repackaged bundle, not the upstream source tree.
# The tag archive ships the pre-built remux5 blobs under src/ffmpeg/bin/,
# which are stripped via Files-Excluded in debian/copyright.
# Not verified against uscan in this environment - run
# `uscan --no-download --verbose` on a Debian/Ubuntu box before relying on it.
version=4
opts="filenamemangle=s%(?:.*?)?v?(\d[\d.]*)\.tar\.gz%videocut-$1.tar.gz%" \
  https://github.com/kanehekili/VideoCut/tags \
  (?:.*?/)?v?(\d[\d.]*)\.tar\.gz debian uupdate
